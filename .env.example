# Public API used for product data (optional, defaults shown)
# Comma separated, tried in order. Defaults to the official API plus two backups.
API_BASE_URLS=https://openapi.programming-hero.com/api/bazardor,https://api.api-store.workers.dev/api/bazardor,https://api.abcz.workers.dev/api/bazardor

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app, for example http://localhost:3000 or https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Pooled PostgreSQL connection string (Neon recommended)
DATABASE_URL=
# Optional: direct (non pooled) string used only by `npm run auth:migrate`
DATABASE_URL_UNPOOLED=

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth: https://github.com/settings/developers
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
